# Copy to .env.local and fill in. Only the key for the provider in MODEL is required.

# Main model, as "provider:model-id". Providers: anthropic | openai | google
#   anthropic:claude-sonnet-5-5   (strongest at tool use and careful "what changed" answers)
#   google:gemini-3-flash-preview (works on a free AI Studio key, but the free quota is ~20 requests/day)
#   bedrock:us.anthropic.claude-sonnet-5-5 (Claude through AWS; uses AWS credits)
MODEL=anthropic:claude-sonnet-5-5

# Small, cheap model for the background fact-extraction job (same "provider:model" format).
# Leave empty to reuse MODEL.
EXTRACT_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Amazon Bedrock (only if MODEL starts with "bedrock:"). Use EITHER a Bedrock API key...
AWS_BEARER_TOKEN_BEDROCK=
# ...OR standard AWS credentials (AWS_SESSION_TOKEN too if yours are temporary):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Web search (https://tavily.com, free tier is enough)
TAVILY_API_KEY=

# Optional: where the SQLite file lives (default ./data/minimi.db)
# DB_PATH=./data/minimi.db
